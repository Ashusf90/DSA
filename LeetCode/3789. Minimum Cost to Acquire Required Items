class Solution {
    public long minimumCost(int cost1, int cost2, int costBoth, int need1, int need2) {
        long overlap=Math.min(need1, need2);
        long ans=overlap*Math.min(costBoth, cost1+cost2);
        if(need1>overlap){
            ans+=(need1-overlap)*Math.min(cost1, costBoth);
        }else if(need2>overlap){
            ans+=(need2-overlap)*Math.min(cost2, costBoth);
        }
        return ans;
    }
}
