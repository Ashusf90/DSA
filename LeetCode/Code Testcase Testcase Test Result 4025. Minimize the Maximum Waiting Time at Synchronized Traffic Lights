class Solution {
    public int minPenalty(int period, int[] lights, int[] arrivalTime) {
        int maxGreen = 0;
        for (int g : lights) {
            maxGreen = Math.max(maxGreen, g);
        }
        int ans = 0;
        for (int t : arrivalTime) {
            int r = t % period;
            if (r >= maxGreen) {
                ans = Math.max(ans, period - r);
            }
        }
        return ans;
    }
}
