class Solution {
    public int minimumDeletions(String s) {
        int b=0;
        int del=0;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='b'){
                b++;
            }else{
                del=Math.min(del+1,b);
            }
        }
        return del;
    }
}
