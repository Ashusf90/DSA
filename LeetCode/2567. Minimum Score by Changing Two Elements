class Solution {
    public int minimizeSum(int[] nums) {
        int n=nums.length;
        if(n<=3){
            return 0;
        }
        Arrays.sort(nums);
        int s=nums[n-1]-nums[2];
        int e=nums[n-2]-nums[1];
        int l=nums[n-3]-nums[0];
        return Math.min(s, Math.min(e, l));
    }
}
