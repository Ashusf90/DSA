class Solution {
    public boolean sumGame(String num) {
        int n = num.length();
        int leftSum = 0, rightSum = 0;
        int leftQ = 0, rightQ = 0;
        for (int i = 0; i < n; i++) {
            char ch = num.charAt(i);
            if (ch == '?') {
                if (i < n / 2) {
                    leftQ++;
                } else {
                    rightQ++;
                }
            } else {
                if (i < n / 2) {
                    leftSum += ch - '0';
                } else {
                    rightSum += ch - '0';
                }
            }
        }
        if ((leftQ + rightQ) % 2 == 1) {
            return true;
        }
        return leftSum - rightSum != (rightQ - leftQ) * 9 / 2;


    }
}
